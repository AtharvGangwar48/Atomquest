generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum SheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REWORK
}

enum GoalStatus {
  PENDING
  ON_TRACK
  COMPLETED
}

enum UomType {
  PERCENTAGE
  NUMBER
  CURRENCY
  BOOLEAN
}

enum ScoringType {
  MAX
  MIN
  TIMELINE
  ZERO
}

enum Period {
  GOAL_SETTING
  Q1
  Q2
  Q3
  Q4
}

enum Quarter {
  Q1
  Q2
  Q3
  Q4
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String   @default("") // empty for SSO-only users
  role         Role     @default(EMPLOYEE)
  managerId    String?  @map("manager_id")
  azureOid     String?  @unique @map("azure_oid") // Azure AD object ID
  manager      User?    @relation("ManagerEmployee", fields: [managerId], references: [id])
  reports      User[]   @relation("ManagerEmployee")
  createdAt    DateTime @default(now()) @map("created_at")

  goalSheets       GoalSheet[]
  checkinComments  CheckinComment[]
  auditLogs        AuditLog[]
  sharedGoals      Goal[]           @relation("SharedGoalOwner")
  grantedUnlocks   GoalUnlock[]     @relation("UnlockAdmin")
  escalationLogs   EscalationLog[]

  @@map("users")
}

model GoalSheet {
  id         String      @id @default(uuid())
  employeeId String      @map("employee_id")
  employee   User        @relation(fields: [employeeId], references: [id])
  cycleYear  Int         @map("cycle_year")
  status     SheetStatus @default(DRAFT)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  goals           Goal[]
  checkinComments CheckinComment[]
  unlocks         GoalUnlock[]

  @@unique([employeeId, cycleYear])
  @@map("goal_sheets")
}

model Goal {
  id            String      @id @default(uuid())
  sheetId       String      @map("sheet_id")
  sheet         GoalSheet   @relation(fields: [sheetId], references: [id])
  thrustArea    String      @map("thrust_area")
  title         String
  description   String?
  uomType       UomType     @map("uom_type")
  scoringType   ScoringType @default(MAX) @map("scoring_type")
  target        Float
  deadline      DateTime?   // used when scoringType = TIMELINE
  weightage     Float
  isShared      Boolean     @default(false) @map("is_shared")
  sharedOwnerId String?     @map("shared_owner_id")
  sharedOwner   User?       @relation("SharedGoalOwner", fields: [sharedOwnerId], references: [id])
  status        GoalStatus  @default(PENDING)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  actuals GoalActual[]

  @@map("goals")
}

model GoalActual {
  id            String   @id @default(uuid())
  goalId        String   @map("goal_id")
  goal          Goal     @relation(fields: [goalId], references: [id])
  quarter       Quarter
  actualValue   Float    @map("actual_value")
  completedDate DateTime? @map("completed_date") // used when scoringType = TIMELINE
  score         Float    @default(0)             // server-computed 0-1
  loggedAt      DateTime @default(now()) @map("logged_at")

  @@unique([goalId, quarter])
  @@map("goal_actuals")
}

model CycleConfig {
  id           String   @id @default(uuid())
  cycleYear    Int      @unique @map("cycle_year")
  // ISO month (1-12) each period starts
  goalSettingStart Int  @default(1)  @map("goal_setting_start")
  q1Start      Int      @default(1)  @map("q1_start")
  q2Start      Int      @default(4)  @map("q2_start")
  q3Start      Int      @default(7)  @map("q3_start")
  q4Start      Int      @default(10) @map("q4_start")
  updatedAt    DateTime @updatedAt   @map("updated_at")

  @@map("cycle_config")
}

model CheckinComment {
  id        String   @id @default(uuid())
  sheetId   String   @map("sheet_id")
  sheet     GoalSheet @relation(fields: [sheetId], references: [id])
  managerId String   @map("manager_id")
  manager   User     @relation(fields: [managerId], references: [id])
  quarter   Quarter
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("checkin_comments")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String   @default("UPDATE") // CREATE | UPDATE | DELETE
  changedBy  String   @map("changed_by")
  changer    User     @relation(fields: [changedBy], references: [id])
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  changedAt  DateTime @default(now()) @map("changed_at")

  @@index([entityType, entityId])
  @@index([changedAt])
  @@map("audit_log")
}

model GoalUnlock {
  id            String    @id @default(uuid())
  sheetId       String    @map("sheet_id")
  sheet         GoalSheet @relation(fields: [sheetId], references: [id])
  grantedBy     String    @map("granted_by")
  admin         User      @relation("UnlockAdmin", fields: [grantedBy], references: [id])
  justification String
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("goal_unlocks")
}

model EscalationRule {
  id            String   @id @default(uuid())
  name          String   @unique
  triggerEvent  String   @map("trigger_event")  // GOAL_NOT_SUBMITTED | APPROVAL_PENDING | ACTUAL_NOT_LOGGED
  thresholdDays Int      @map("threshold_days")
  notifyRole    Role     @map("notify_role")    // who gets notified
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  logs EscalationLog[]

  @@map("escalation_rules")
}

model EscalationLog {
  id         String         @id @default(uuid())
  ruleId     String         @map("rule_id")
  rule       EscalationRule @relation(fields: [ruleId], references: [id])
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id])
  message    String
  sentAt     DateTime       @default(now()) @map("sent_at")
  channel    String         @default("EMAIL") // EMAIL | TEAMS

  @@map("escalation_log")
}
